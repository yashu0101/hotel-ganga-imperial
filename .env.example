# Server-only: admin access remains disabled until configured.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Generate a random secret of at least 32 characters.
JWT_SECRET=
# Optional Neon database; absent uses the local JSON store.
DATABASE_URL=
# Keep false except for a deliberate authenticated database setup.
ALLOW_DATABASE_SEED=false

# Replace placeholders with verified hotel details.
NEXT_PUBLIC_HOTEL_PHONE=
NEXT_PUBLIC_HOTEL_WHATSAPP=
NEXT_PUBLIC_HOTEL_EMAIL=
NEXT_PUBLIC_HOTEL_ADDRESS=
NEXT_PUBLIC_HOTEL_MAP_URL=

# Public launch: leave indexing disabled while placeholder information is present.
NEXT_PUBLIC_SITE_URL=
SITE_READY_FOR_INDEXING=false
# Optional notification automation: HTTPS receiver must verify HMAC and deduplicate event IDs.
# It receives reservation data to send staff alerts and guest acknowledgements.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
