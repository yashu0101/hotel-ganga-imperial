# Server-only: admin access remains disabled until configured.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Generate a random secret of at least 32 characters.
JWT_SECRET=
# Neon database. Required for Vercel production (the build fails without it); locally,
# leaving it empty uses data/db.json.
DATABASE_URL=
# Keep false except for a deliberate authenticated database setup.
ALLOW_DATABASE_SEED=false
# Optional, local only: store the JSON content file somewhere other than data/db.json (the end-to-end tests use
# e2e/.data/db.json), and put the build output in another folder (NEXT_DIST_DIR, so tests can run beside npm run dev).
HOTEL_DB_FILE=
NEXT_DIST_DIR=

# Replace placeholders with verified hotel details.
NEXT_PUBLIC_HOTEL_PHONE=
NEXT_PUBLIC_HOTEL_WHATSAPP=
NEXT_PUBLIC_HOTEL_EMAIL=
NEXT_PUBLIC_HOTEL_ADDRESS=
NEXT_PUBLIC_HOTEL_MAP_URL=

# Public launch: leave indexing disabled while placeholder information is present.
NEXT_PUBLIC_SITE_URL=
SITE_READY_FOR_INDEXING=false
# Optional notification automation: HTTPS receiver must verify HMAC and deduplicate event IDs.
# It receives reservation data to send staff alerts and guest acknowledgements.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
# Vercel Cron retries queued notifications daily (03:30 UTC) via /api/cron/notifications. Hobby plans allow daily crons only; on Pro you can shorten the schedule in vercel.json.
# Set a random secret of at least 32 characters; Vercel sends it as a Bearer token.
CRON_SECRET=
